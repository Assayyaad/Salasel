{
  "name": "salasel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:data": "node -e \"require('./bin/func/cli/cmd/csv-to-json.js').convertToJson().then(() => process.exit(0)).catch(e => { console.error(e); process.exit(1); })\"",
    "start": "next start",
    "cli": "node bin/cli.js",
    "seed": "APP_ENV=production node bin/seed.js",
    "seed:local": "APP_ENV=development node bin/seed.js",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "lint": "eslint",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,mjs}": "prettier --write"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.33",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "fs-extra": "^11.3.3",
    "husky": "^9.1.7",
    "inquirer": "^13.2.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "supabase": "^2.107.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "youtube-sr": "^4.3.12",
    "dotenv": "^16.4.5"
  }
